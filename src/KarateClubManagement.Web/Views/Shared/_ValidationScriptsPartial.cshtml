<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Club de Karaté</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/Dashboard">Club de Karaté</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Tableau de bord</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Members" asp-action="Index">Membres</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Coaches" asp-action="Index">Entraîneurs</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Courses" asp-action="Index">Cours</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Exams" asp-action="Index">Examens</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Payments" asp-action="Index">Paiements</a></li>
                </ul>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light">Déconnexion</button>
                    </form>
                }
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
