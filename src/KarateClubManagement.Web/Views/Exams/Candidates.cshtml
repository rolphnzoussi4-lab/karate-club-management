@model GradeExam

<h2>Planifier un examen</h2>
<form asp-action="Create" method="post">
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">Titre</label><input asp-for="Title" class="form-control" /></div>
        <div class="col-md-6"><label class="form-label">Lieu</label><input asp-for="Location" class="form-control" /></div>
        <div class="col-md-6"><label class="form-label">Date</label><input asp-for="ExamDate" class="form-control" type="date" /></div>
        <div class="col-12"><label class="form-label">Description</label><textarea asp-for="Description" class="form-control"></textarea></div>
    </div>
    <button type="submit" class="btn btn-primary mt-3">Enregistrer</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Retour</a>
</form>
