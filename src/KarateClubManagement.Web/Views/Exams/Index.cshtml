@model Course

<h2>Inscription au cours : @Model.Name</h2>

<table class="table table-striped">
    <thead><tr><th>Membre</th><th>Status</th></tr></thead>
    <tbody>
        @foreach (var registration in Model.Registrations)
        {
            <tr><td>@registration.Member?.FirstName @registration.Member?.LastName</td><td>@registration.Status</td></tr>
        }
    </tbody>
</table>

<form method="post">
    <div class="mb-3">
        <label class="form-label">Sélectionner un membre</label>
        <select name="memberId" class="form-select">
            @foreach (var member in ViewBag.Members as List<Member>)
            {
                <option value="@member.Id">@member.FirstName @member.LastName</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Inscrire</button>
</form>
